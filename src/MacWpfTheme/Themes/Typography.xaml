<!-- ============================================================
     macOS 字体体系
     Windows 无 SF Pro：优先 Inter（免费商用），回退 Segoe UI Variable
     ============================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationCore"
                    xmlns:clr="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="Font.Primary">Inter, Segoe UI Variable, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, SF Mono, Consolas</FontFamily>

    <sys:FontWeight x:Key="Font.Weight.Regular">Normal</sys:FontWeight>
    <sys:FontWeight x:Key="Font.Weight.Medium">Medium</sys:FontWeight>
    <sys:FontWeight x:Key="Font.Weight.Semibold">SemiBold</sys:FontWeight>

    <clr:Double x:Key="Font.Size.Caption">11</clr:Double>
    <clr:Double x:Key="Font.Size.Body">13</clr:Double>
    <clr:Double x:Key="Font.Size.Subtitle">15</clr:Double>
    <clr:Double x:Key="Font.Size.Title">17</clr:Double>

</ResourceDictionary>
