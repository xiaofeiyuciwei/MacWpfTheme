<!-- ============================================================
     macOS 无边框窗口（WindowChrome）
     - 无 DWM 毛玻璃、无 BlurEffect（相机高帧率场景不掉帧）
     - 大圆角、自定义标题栏（红绿灯 + 标题 + 功能区）
     - 最大化自动取消圆角（macOS 原生行为）
     - 边缘可拖拽缩放（ResizeBorderThickness）
     ============================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Window.Mac" TargetType="Window">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="38"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              UseAeroCaptionButtons="False"
                              CornerRadius="0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Window}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ===== 标题栏 ===== -->
                            <Grid x:Name="TitleBar" Grid.Row="0"
                                  Background="{DynamicResource Brush.TitleBar}"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：mac 红绿灯 -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                    <Button x:Name="BtnClose" Width="12" Height="12" Margin="0,0,8,0"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FFFD5750" CornerRadius="6" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="BtnMin" Width="12" Height="12" Margin="0,0,8,0"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FFFEBC2E" CornerRadius="6" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="BtnMax" Width="12" Height="12"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FF28C840" CornerRadius="6" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- 标题 -->
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Primary}"
                                           FontSize="{DynamicResource Font.Size.Body}"
                                           FontWeight="{DynamicResource Font.Weight.Medium}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="{TemplateBinding Title}"/>

                                <!-- 右侧功能区（主题切换按钮位） -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,12,0"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button x:Name="BtnThemeToggle" Style="{StaticResource Button.Ghost}"
                                            Width="28" Height="28" Content="☀"
                                            ToolTip="切换浅色 / 深色主题"/>
                                </StackPanel>
                            </Grid>

                            <!-- ===== 客户区 ===== -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
