<!-- ============================================================
     macOS Light 浅色主题色板
     采用 macOS 原生色系：柔和中性底、Apple Blue 主色、低饱和
     ============================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 背景 ===== -->
    <Color x:Key="Color.Bg.Primary">#F5F5F7</Color>
    <Color x:Key="Color.Bg.Secondary">#FFFFFF</Color>
    <Color x:Key="Color.Bg.Tertiary">#EBEBED</Color>

    <!-- ===== 文字 ===== -->
    <Color x:Key="Color.Text.Primary">#1D1D1F</Color>
    <Color x:Key="Color.Text.Secondary">#6E6E73</Color>
    <Color x:Key="Color.Text.Tertiary">#8E8E93</Color>

    <!-- ===== 主色（Apple Blue） ===== -->
    <Color x:Key="Color.Accent">#007AFF</Color>
    <Color x:Key="Color.Accent.Light">#E1F0FF</Color>
    <Color x:Key="Color.Accent.Hover">#3395FF</Color>

    <!-- ===== 状态色 ===== -->
    <Color x:Key="Color.Success">#34C759</Color>
    <Color x:Key="Color.Warning">#FF9500</Color>
    <Color x:Key="Color.Danger">#FF3B30</Color>

    <!-- ===== 边框 ===== -->
    <Color x:Key="Color.Border">#D2D2D7</Color>
    <Color x:Key="Color.Border.Focus">#007AFF70</Color>

    <!-- ===== 画刷包装 ===== -->
    <SolidColorBrush x:Key="Brush.Bg.Primary" Color="{StaticResource Color.Bg.Primary}"/>
    <SolidColorBrush x:Key="Brush.Bg.Secondary" Color="{StaticResource Color.Bg.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Bg.Tertiary" Color="{StaticResource Color.Bg.Tertiary}"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Accent.Light" Color="{StaticResource Color.Accent.Light}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}"/>

    <SolidColorBrush x:Key="Brush.TitleBar" Color="#E8E8EC"/>

</ResourceDictionary>
