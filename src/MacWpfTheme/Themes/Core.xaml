<!-- ============================================================
     macOS 核心：间距栅格、分级圆角、弱阴影、卡片、标签
     （无任何 BlurEffect，保证相机 / 视觉高帧率场景不掉帧）
     ============================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 间距体系（4 基数栅格） ===== -->
    <Thickness x:Key="Space.4">4</Thickness>
    <Thickness x:Key="Space.8">8</Thickness>
    <Thickness x:Key="Space.12">12</Thickness>
    <Thickness x:Key="Space.16">16</Thickness>
    <Thickness x:Key="Space.20">20</Thickness>
    <Thickness x:Key="Space.24">24</Thickness>

    <!-- ===== 分级圆角（mac 非统一圆角） ===== -->
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">10</CornerRadius>
    <CornerRadius x:Key="Radius.Window">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">9999</CornerRadius>

    <!-- ===== 弱阴影（极低透明度，mac 无硬阴影） ===== -->
    <DropShadowEffect x:Key="Shadow.Soft" Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.14"/>
    <DropShadowEffect x:Key="Shadow.Card" Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.10"/>

    <!-- ===== 卡片（Inspector 参数面板、分组容器） ===== -->
    <Style x:Key="Card.Mac" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Secondary}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.16}"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===== 标签 ===== -->
    <Style x:Key="Label.Body" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Regular}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="Label.Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Regular}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="Label.SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subtitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Semibold}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

</ResourceDictionary>
